# Open WebUI configuration for image_chat.py
# Copy this file to .env and fill in your values.

# API key (or JWT) for your Open WebUI instance.
# Obtain it from Settings > Account in Open WebUI.
OPEN_WEBUI_API_KEY=your-api-key-here

# Base URL of your local Open WebUI instance.
OPEN_WEBUI_BASE_URL=http://localhost:3000

# Default model ID to use (e.g. an Ollama, OpenAI, or custom function model).
OPEN_WEBUI_MODEL=qwen3.6:27b

# Default tool ID(s) to use (e.g. 'server:mcp:YOUR_MCP_SERVER_ID').
# Find available tools with: python image_chat.py --list-tools
# Note: set up API key first!
OPEN_WEBUI_TOOL_ID=server:mcp:YOUR_MCP_SERVER_ID

# Default skill ID(s) to use.
# Find available skills with: python image_chat.py --list-skills
# Note: set up API key first!
OPEN_WEBUI_SKILL_ID=

# Write an interaction log (input, thoughts, output) to <image_stem>.log.
# Disabled by default. Set to 1/true/yes/on to enable, or pass --log on the CLI.
OPEN_WEBUI_LOG=0
